      <!--                <linkFlags>-->
      <!--                    <li>Wall</li>-->
      <!--                    <li>Rock</li>-->
      <!--                </linkFlags>-->
      <!--                <linkToDoors>true</linkToDoors>-->
      <!--                <drawDoorBorderEast>-->
      <!--                    <color>(0,0,0)</color>-->
      <!--                    <size>(0.04, 0.77)</size>-->
      <!--                    <offset>(0.5, 0, -0.08)</offset>-->
      <!--                </drawDoorBorderEast>-->
      <!--                <drawDoorBorderWest>-->
      <!--                    <color>(0,0,0)</color>-->
      <!--                    <size>(0.04, 0.77)</size>-->
      <!--                    <offset>(-0.5, 0, -0.08)</offset>-->
      <!--                </drawDoorBorderWest>-->
      <!--            </asymmetricLink>-->
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.35,0.1,0.3,0.7)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Fence_MenuIcon</uiIconPath>
    <uiIconPathsStuff>
      <li>
        <appearance>Metal</appearance>
        <iconPath>Things/Building/Linked/FenceMetal_MenuIcon</iconPath>
      </li>
    </uiIconPathsStuff>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>70</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <costStuffCount>1</costStuffCount>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.25</fillPercent>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <tickerType>Never</tickerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiOrder>2020</uiOrder>
    <canOverlapZones>false</canOverlapZones>
    <fertility>0</fertility>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <building>
      <isInert>true</isInert>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <relatedBuildCommands>
        <li>PenMarker</li>
        <li>FenceGate</li>
      </relatedBuildCommands>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Fence_Blueprint</texPath>
        <graphicClass>Graphic_Appearances</graphicClass>
      </blueprintGraphicData>
      <paintable>true</paintable>
    </building>
  </ThingDef>

  <ThingDef ParentName="MVO_ShipwreckPropsBase">
    <defName>Barricade_NAWDiagonal</defName>
    <label>barricade</label>
    <description>A waist-high barrier for use as cover from incoming shots. Barricades are ugly, but provide better cover than other low objects. Barricades will block certain kinds of animals the same way that fences do.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <replaceTags>
      <li>Barricade</li>
    </replaceTags>
    <graphicData>
      <texPath>Things/Building/Linked/Barricade_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>217</linkType>
      <linkFlags>
        <li>Barricades</li>
      </linkFlags>
      <color>(139,122,87)</color>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Barricade_MenuIcon</uiIconPath>
    <uiIconScale>1.2</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>42</pathCost>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.55</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <uiOrder>10</uiOrder>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Beauty>-3</Beauty>
      <WorkToBuild>320</WorkToBuild>
      <Flammability>1</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Barricade_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
      <paintable>true</paintable>
    </building>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>5</costStuffCount>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded> <!-- Best affordance needed for stone -->
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
  </ThingDef>

</Defs>