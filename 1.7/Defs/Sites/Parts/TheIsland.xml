<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SitePartDef>
    <defName>MVO_Dungeon</defName>
    <label>dungeon</label>
    <description>An ancient, enclosed structure filled with unknown dangers and potential riches.</description>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>MapVehiclesOcean/World/Dungeon</expandingIconTexture>
    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
    <minMapSize>(200,0,200)</minMapSize>
    <tags>
      <li>MVO_TheIsland</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>MVO_Dungeon</defName>
    <linkWithSite>MVO_Dungeon</linkWithSite>
    <order>400</order>
    <genStep Class="MapVehiclesOcean.GenStep_Dungeon">
      <prefabDef>MVO_Dungeon</prefabDef>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MVO_GoldLump</defName>
    <linkWithSite>MVO_Dungeon</linkWithSite>
    <order>900</order>
    <genStep Class="GenStep_PreciousLump">
      <mineables>
        <li>MineableGold</li>
      </mineables>
      <totalValueRange>40000~50000</totalValueRange>
    </genStep>
  </GenStepDef>
  
</Defs>