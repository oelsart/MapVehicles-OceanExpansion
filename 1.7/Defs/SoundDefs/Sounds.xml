<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SoundDef>
    <defName>MVO_WaterSplash</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>MapVehiclesOcean/Water_Splash</clipPath>
          </li>
        </grains>
        <volumeRange>10~25</volumeRange>
        <pitchRange>0.8~2.5</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>MVO_CannonballImpact</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>MapVehiclesOcean/Cannonball_Impact</clipPath>
          </li>
        </grains>
        <volumeRange>35~35</volumeRange>
      </li>
    </subSounds>
  </SoundDef>
  
  <SoundDef>
    <defName>MVO_PageFlip</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>MapVehiclesOcean/PageFlip</clipPath>
          </li>
        </grains>
        <volumeRange>100~100</volumeRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>MVO_EarthRumble</defName>
    <context>WorldOnly</context>
    <sustain>true</sustain>
    <priorityMode>PrioritizeExisting</priorityMode>
    <sustainFadeoutTime>4</sustainFadeoutTime>
    <subSounds>
      <li>
        <onCamera>true</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>MapVehiclesOcean/EarthRumble</clipPath>
          </li>
        </grains>
        <volumeRange>75~75</volumeRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>