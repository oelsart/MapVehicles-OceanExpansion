<?xml version="1.0" encoding="utf-8"?>
<Patch>
  
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PreceptDef[defName="IdeoRole_Leader"]/conflictingMemes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/PreceptDef[defName="IdeoRole_Leader"]/conflictingMemes</xpath>
      <value>
        <li>MVO_Seafaring</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PreceptDef[defName="IdeoRole_Leader"]</xpath>
      <value>
        <conflictingMemes>
          <li>MVO_Seafaring</li>
        </conflictingMemes>
      </value>
    </nomatch>
  </Operation>
  
</Patch>