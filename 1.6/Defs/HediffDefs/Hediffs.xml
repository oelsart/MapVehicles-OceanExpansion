<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>MVO_Scurvy</defName>
    <label>scurvy</label>
    <description>A disease caused by severe deficiency of vitamin C.</description>
    <hediffClass>MapVehiclesOcean.Hediff_VitaminDeficiency</hediffClass>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <tendable>true</tendable>
    <initialSeverity>0.1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.06</severityPerDayTended>
        <showTendQuality>false</showTendQuality>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.05</severityPerDay>
      </li>
      <li Class="MapVehiclesOcean.HediffCompProperties_VitaminC">
        <vitaminSources>
          <RawPotatoes>0.15</RawPotatoes>
          <Chocolate>0.05</Chocolate>
          <SmokeleafLeaves>0.05</SmokeleafLeaves>
          <RawBerries>0.1</RawBerries>

          <!-- Vanilla Plants Expanded -->
