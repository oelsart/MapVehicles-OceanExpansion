          <VCE_RawTomatoes MayRequire="VanillaExpanded.VPlantsE">0.15</VCE_RawTomatoes>
          <VCE_RawApple MayRequire="VanillaExpanded.VPlantsE">0.15</VCE_RawApple>
          <VCE_RawPeach MayRequire="VanillaExpanded.VPlantsE">0.12</VCE_RawPeach>
