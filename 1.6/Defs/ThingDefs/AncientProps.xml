  <ThingDef ParentName="MVO_AncientPropsBase">
    <defName>MVO_Bowl</defName>
    <label>bowl</label>
    <description>A simple bowl. Put some gold on it.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>MapVehiclesOcean/Things/Ancient/Bowl</texPath>
