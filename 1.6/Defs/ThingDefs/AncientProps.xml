        <offsetEast>(0.25,0,0.3)</offsetEast>
        <offsetWest>(-0.25,0,0.3)</offsetWest>
        <offsetSouth>(0,0,0.1)</offsetSouth>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(184,136,83,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
  
