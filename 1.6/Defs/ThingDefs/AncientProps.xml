  <ThingDef Name="MVO_AncientPillar" ParentName="MVO_AncientPropsBase">
    <defName>MVO_AncientPillar</defName>
    <label>ancient pillar</label>
    <description>an ancient pillar with a burning light.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>MapVehiclesOcean/Things/Ancient/AncientPillar/AncientPillar</texPath>
      <drawSize>1.5</drawSize>
      <color>(255,235,122)</color>
      <drawOffsetNorth>(0,0,-0.4)</drawOffsetNorth>
      <drawOffsetEast>(-0.25,0,0)</drawOffsetEast>
      <drawOffsetWest>(0.25,0,0)</drawOffsetWest>
      <drawOffsetSouth>(0,0,0.4)</drawOffsetSouth>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Beauty>5</Beauty>
    </statBases>
    <fillPercent>0.5</fillPercent>
