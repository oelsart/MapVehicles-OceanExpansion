  <ThingDef ParentName="MVO_StatueBase">
    <defName>MVO_Midas</defName>
    <label>statue of Midas</label>
    <description>An ancient monument forged in the likeness of a legendary king from Earth's cradle worlds, who turned everything he touched into solid gold. The metal shows no sign of wear, and a strange, avaricious pull seems to emanate from its hollow eyes.</description>
    <graphicData>
      <texPath>MapVehiclesOcean/Things/Ancient/Midas</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MVO_StatueBase">
    <defName>MVO_Minotaur</defName>
    <label>statue of Minotaur</label>
    <description>A menacing gold effigy of a legendary horned beast from ancient terrestrial mythology, trapped at the heart of a labyrinthine prison. The polished gold radiates an oppressive hostility, as if the legendary monster still paces restlessly within the dark corridors of its maze.</description>
    <graphicData>
      <texPath>MapVehiclesOcean/Things/Ancient/Minotaur</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MVO_StatueBase">
    <defName>MVO_Athena</defName>
    <label>statue of Athena</label>
    <description>A gleaming golden effigy honoring an ancient terrestrial deity of martial strategy and unyielding victory, clad in impenetrable plate and brandishing a raised spear. Its piercing gaze seems to calculate battlefields and weaknesses, radiating an intimidating aura of tactical supremacy.</description>
    <graphicData>
      <texPath>MapVehiclesOcean/Things/Ancient/Athena</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="MVO_StatueBase">
    <defName>MVO_Poseidon</defName>
    <label>statue of Poseidon</label>
    <description>A colossal golden effigy depicting an ancient terrestrial sovereign of the deep seas and roaring tempests, gripping a massive trident. The statue exudes a heavy, damp pressure, as if the wrath of the abyssal depths and hungry tides still stirs beneath its feet.</description>
    <graphicData>
      <texPath>MapVehiclesOcean/Things/Ancient/Poseidon</texPath>
    </graphicData>
  </ThingDef>

