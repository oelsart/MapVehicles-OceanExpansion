    <description>Wood plank flooring for that warm, homey feeling. While it is quick to lay, it is also very flammable.</description>
    <texturePath>Terrain/Surfaces/WoodFloor</texturePath>
    <bridgePropsPath>MapVehiclesOcean/Terrain/WoodShipProps/WoodShipPropsA</bridgePropsPath>
    <color>(108,78,55)</color>
    <edgeType>Hard</edgeType>
    <bridge>true</bridge>
    <isFoundation>true</isFoundation>
    <renderPrecedence>250</renderPrecedence>
    <preventCraters>true</preventCraters>
    <designationCategory>MVO_Dev</designationCategory>
    <statBases>
      <Flammability>0.22</Flammability>
    </statBases>
    <terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
